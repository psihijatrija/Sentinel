<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48-windows</TargetFramework>
    <AssemblyName>NanoAV</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>5</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>src/NanoApp.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Match the supplied build-nanoav.ps1 /warn:0 without editing vendor code. -->
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
</Project>
