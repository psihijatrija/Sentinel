<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>3.1.7</Version>
    <Company>Sentinel Security</Company>
    <Product>Sentinel Endpoint Detection and Response</Product>
    <Description>Sentinel EDR User-Session Agent and Web Dashboard</Description>
    <Copyright>Copyright (c) 2026 Sentinel Contributors</Copyright>
    <Authors>Sentinel</Authors>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>..\..\installer\assets\Sentinel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentinel.Core\Sentinel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Edge/Chromium dashboard host. Requires the Edge WebView2 Runtime on the target
         (pre-installed on current Win10/11). AgentDashboardForm falls back to the legacy
         WinForms WebBrowser (IE11 emulation) when the runtime is unavailable, so a missing
         runtime degrades gracefully rather than breaking Settings. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />

    <!-- Compile-time types for hosting Windows PowerShell 5.1 in-process
         (AntivirusLiteHost). These are REFERENCE assemblies only - the real
         System.Management.Automation implementation loads from the GAC at
         runtime (present on every supported Windows box), so nothing extra is
         shipped. Private/ExcludeAssets keep the ref DLLs out of the output. -->
    <PackageReference Include="Microsoft.PowerShell.5.ReferenceAssemblies" Version="1.1.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded AntivirusLite engine script. Copied beside Sentinel.Agent.exe
         so AntivirusLiteHost can locate and host it in-process. Remove this
         block (and the modules\AntivirusLite folder) to fully drop the module. -->
    <None Include="..\..\modules\AntivirusLite\AntivirusLite.ps1"
          Link="modules\AntivirusLite\AntivirusLite.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
